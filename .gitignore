# Node
node_modules/
frontend/dist/

# Python
__pycache__/
*.pyc
.pytest_cache/

# Logs
*.log

# Session handoff notes (local reference only, not for the repo)
SESSION_NOTES_*.md

# Usage counters (internal-only, see backend/stats.py) - never committed,
# unlike the product catalog cache, since this is meant to be visible only
# via the gated /api/stats endpoint, never in git history.
.cache/usage_stats.json

# Hamper catalog upload cache (backend/hampers/api.py) - a runtime artifact
# that gets rewritten on every manual upload/restart, same reasoning as the
# usage counters above; giftbox_data/ already holds the checked-in source.
.cache/hamper_catalog.*
